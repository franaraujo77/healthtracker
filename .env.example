# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# Supabase project settings — get from: Supabase dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Supabase Expo env (mirrors above — Expo uses EXPO_PUBLIC_ prefix)
EXPO_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Supabase service-role key — server-only. Required by:
#   - packages/api (signed-URL creation for lab-uploads + Story 5.5 exports)
#   - services/extraction (Storage downloads from `lab-uploads`)
#   - services/llm (Story 5.5 — Storage uploads to `exports`)
# NEVER expose to clients; lives in Vercel + Railway server-side env only.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Database connection URL — use the SESSION-MODE pooler URL (not transaction-mode PgBouncer)
# Get from: Supabase dashboard > Settings > Database > Connection string > Session mode
# IMPORTANT: Story 0.4 explains why session-mode is required for SET LOCAL (RLS pattern)
DATABASE_URL="postgresql://postgres.[USERNAME]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# CORS allowed origin for tRPC — set to your web app URL in production
CORS_ORIGIN="http://localhost:3000"

# Direct (non-pooled) Postgres URL for pg-boss worker — must NOT use PgBouncer
# Get from: Supabase dashboard > Settings > Database > Connection string > Direct connection
# pg-boss uses advisory locks and NOTIFY; PgBouncer in any mode is incompatible.
WORKER_DATABASE_URL="postgresql://postgres.[USERNAME]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# --- Story 4.1 — services/llm (Anthropic Claude Sonnet, SSE streaming) ---
# Anthropic API key. NFR-S6 launch blocker: production deploy of services/llm
# is gated on a signed Anthropic DPA. Leave empty in dev/CI to use the stub
# adapter (renders a placeholder Letter body so the SSE plumbing is exercised
# end-to-end without burning real tokens).
ANTHROPIC_API_KEY=""

# Internal base URL of the persistent services/llm server.
# Dev: localhost:3001 via `pnpm --filter @healthtracker/llm-service dev`.
# Staging/prod: Railway-managed persistent server. Vercel Edge tops SSE
# streams at ~25s so the LLM service runs OFF Vercel by design.
LLM_SERVICE_URL="http://localhost:3001"

# Expo client base URL for the LetterReader SSE connection. Mirrors
# LLM_SERVICE_URL with the EXPO_PUBLIC_ prefix Metro inlines at build.
EXPO_PUBLIC_LLM_SERVICE_URL="http://localhost:3001"

# --- Story 5.1 — Sharing (Epic 5) ---
# HMAC secret used to sign share-link tokens. 64 random bytes,
# base64-encoded. Required in production (NFR-S6 boot gate); dev/test
# falls back to a deterministic dev-only value with a console warning.
# Generate: `openssl rand -base64 64 | tr -d '\n'`.
SHARE_TOKEN_HMAC_SECRET=""

# --- Story 5.6 — Account deletion (Epic 5) ---
# Salt mixed into the sha256 pseudonymization of audit_log rows for
# deleted patients (AR20 — pseudonymize, never delete). 64 random
# bytes, base64-encoded. Required in production (NFR-S6 boot gate at
# services/llm); dev/test falls back to a deterministic dev-only salt
# with a console warning. Salt rotation invalidates linkability across
# the boundary — accepted limitation; documented in CLAUDE.md.
# Generate: `openssl rand -base64 64 | tr -d '\n'`.
ACCOUNT_DELETION_SALT=""

# --- Story 5.2 — Sharing (Epic 5) ---
# Base URL embedded in the magic-link the patient shares with their
# doctor. Epic 6 owns the `/m/<shareTokenId>.<tokenHmac>` doctor-side
# route at this base. Required outside development/test — boot fails
# fast in staging/preview/prod if missing (`packages/api/src/sharing.ts`).
WEB_APP_URL="http://localhost:3000"

# Sentry — get DSN from Sentry dashboard > Settings > Projects > Client Keys
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
EXPO_PUBLIC_SENTRY_DSN=""
