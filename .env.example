# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# Supabase project settings — get from: Supabase dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Supabase Expo env (mirrors above — Expo uses EXPO_PUBLIC_ prefix)
EXPO_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Database connection URL — use the SESSION-MODE pooler URL (not transaction-mode PgBouncer)
# Get from: Supabase dashboard > Settings > Database > Connection string > Session mode
# IMPORTANT: Story 0.4 explains why session-mode is required for SET LOCAL (RLS pattern)
DATABASE_URL="postgresql://postgres.[USERNAME]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# CORS allowed origin for tRPC — set to your web app URL in production
CORS_ORIGIN="http://localhost:3000"

# Direct (non-pooled) Postgres URL for pg-boss worker — must NOT use PgBouncer
# Get from: Supabase dashboard > Settings > Database > Connection string > Direct connection
# pg-boss uses advisory locks and NOTIFY; PgBouncer in any mode is incompatible.
WORKER_DATABASE_URL="postgresql://postgres.[USERNAME]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
