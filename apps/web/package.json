{
  "name": "@healthtracker/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm with-env next build",
    "clean": "git clean -xdf .cache .next .turbo node_modules",
    "dev": "pnpm with-env next dev",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "start": "pnpm with-env next start",
    "test:a11y": "playwright test __tests__/a11y/",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@healthtracker/api": "workspace:*",
    "@healthtracker/auth": "workspace:*",
    "@healthtracker/config": "workspace:*",
    "@healthtracker/db": "workspace:*",
    "@healthtracker/ui": "workspace:*",
    "@healthtracker/validators": "workspace:*",
    "@sentry/nextjs": "catalog:",
    "@supabase/ssr": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tamagui/core": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "next": "^15.3.0",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "superjson": "2.2.3",
    "tamagui": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@healthtracker/eslint-config": "workspace:*",
    "@healthtracker/prettier-config": "workspace:*",
    "@healthtracker/tailwind-config": "workspace:*",
    "@healthtracker/tsconfig": "workspace:*",
    "@playwright/test": "^1.50.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "eslint": "catalog:",
    "jiti": "^2.5.1",
    "playwright": "^1.50.1",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "prettier": "@healthtracker/prettier-config"
}
