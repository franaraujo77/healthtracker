{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "packageRules": [
    {
      "matchPackagePatterns": ["^@healthtracker/"],
      "enabled": false
    },
    {
      "groupName": "turborepo",
      "matchPackageNames": [
        "turbo",
        "@turbo/gen",
        "eslint-plugin-turbo",
        "eslint-config-turbo"
      ]
    }
  ],
  "updateInternalDeps": true,
  "rangeStrategy": "bump",
  "automerge": true,
  "npm": {
    "fileMatch": ["(^|/)package\\.json$", "(^|/)package\\.json\\.hbs$"]
  }
}
