{
  "name": "@healthtracker/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./upload-transitions": {
      "types": "./dist/src/upload-transitions.d.ts",
      "default": "./src/upload-transitions.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@healthtracker/auth": "workspace:*",
    "@healthtracker/db": "workspace:*",
    "@healthtracker/types": "workspace:*",
    "@healthtracker/validators": "workspace:*",
    "@trpc/server": "catalog:",
    "superjson": "2.2.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@healthtracker/eslint-config": "workspace:*",
    "@healthtracker/prettier-config": "workspace:*",
    "@healthtracker/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "pdf-lib": "^1.17.1",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@healthtracker/prettier-config"
}
