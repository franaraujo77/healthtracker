{
  "name": "@healthtracker/ui",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./button": "./src/button.tsx",
    "./dropdown-menu": "./src/dropdown-menu.tsx",
    "./field": "./src/field.tsx",
    "./input": "./src/input.tsx",
    "./label": "./src/label.tsx",
    "./providers": "./src/providers/TamaguiProvider.tsx",
    "./theme/tokens": "./src/theme/tokens.ts",
    "./separator": "./src/separator.tsx",
    "./toast": "./src/toast.tsx"
  },
  "license": "MIT",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "ui-add": "pnpm dlx shadcn@latest add && prettier src --write --list-different"
  },
  "dependencies": {
    "@tamagui/animations-css": "catalog:",
    "@tamagui/core": "catalog:",
    "@tamagui/web": "catalog:",
    "tamagui": "catalog:"
  },
  "devDependencies": {
    "@healthtracker/eslint-config": "workspace:*",
    "@healthtracker/prettier-config": "workspace:*",
    "@healthtracker/tsconfig": "workspace:*",
    "@types/react": "catalog:react19",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:react19",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:react19",
    "zod": "catalog:"
  },
  "prettier": "@healthtracker/prettier-config"
}
