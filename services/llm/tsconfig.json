{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tooling/typescript/base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": ".cache/tsbuildinfo.json",
    "lib": ["ES2022"],
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": ["src"]
}
